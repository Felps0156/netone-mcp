# NetOne configuration template. Never include real credentials or private hosts.
NETONE_BASE_URL=https://example.invalid
TOKEN_NETONE=

# Local safety controls, not provider quotas. Query POST retries remain zero.
NETONE_TIMEOUT_SECONDS=15
NETONE_MAX_RESULTS=100
NETONE_MAX_PAGES=5
# Legacy compatibility only: integer 0-3, validated then ignored.
NETONE_MAX_RETRIES=0
NETONE_LOG_LEVEL=WARNING

# Unused legacy names. No login or password authentication is implemented.
LOGIN_NETONE=
SENHA_NETONE=
